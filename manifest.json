{
  "name": "To-Done Rocket Planner",
  "description": "A tactical daily planner built for focus. Tasks, timers, quick launch, and progress all in your new tab.",
  "version": "1.3",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": ["storage", "tabs", "alarms", "contextMenus"],
  "host_permissions": []
}
